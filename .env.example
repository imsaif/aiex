# ===========================================
# Environment Variables Template
# ===========================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control
# ===========================================

# Anthropic API (for AI features)
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE

# Database Configuration (Neon PostgreSQL)
# For Vercel: Use POSTGRES_URL provided by Vercel Postgres
DATABASE_URL=postgresql://username:password@host/database?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://username:password@host/database?sslmode=require

# Email (Resend) - https://resend.com/api-keys
RESEND_API_KEY=re_YOUR_KEY_HERE

# Admin Configuration
# IMPORTANT: Generate secure secrets with: openssl rand -hex 32
ADMIN_EMAIL=your-admin@example.com
ADMIN_PASSWORD=generate-a-strong-password-min-16-chars
CRON_SECRET=generate-with-openssl-rand-hex-32
ADMIN_APPROVE_SECRET=generate-with-openssl-rand-hex-32

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_MOCK_ANALYSIS=false
