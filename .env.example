# Anthropic API Configuration
# Get your API key from: https://console.anthropic.com/
# Copy this file to .env.local and add your actual API key
ANTHROPIC_API_KEY=your_api_key_here

# Mock Mode - Set to 'true' to test Pattern Lab Analyze Mode without API key
# Set to 'false' or remove to use real Claude Vision API
NEXT_PUBLIC_MOCK_ANALYSIS=true
