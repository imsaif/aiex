{
  "ci": {
    "collect": {
      "url": [
        "https://www.aiuxdesign.guide/",
        "https://www.aiuxdesign.guide/audit",
        "https://www.aiuxdesign.guide/news",
        "https://www.aiuxdesign.guide/agent-readability-audit-kit",
        "https://www.aiuxdesign.guide/patterns/conversational-ui",
        "https://www.aiuxdesign.guide/patterns/graceful-handoff",
        "https://www.aiuxdesign.guide/patterns/explainable-ai",
        "https://www.aiuxdesign.guide/patterns/progressive-disclosure"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "throttlingMethod": "simulate",
        "screenEmulation": {
          "mobile": true,
          "width": 412,
          "height": 823,
          "deviceScaleFactor": 1.75,
          "disabled": false
        }
      }
    },
    "assert": {
      "budgetsFile": "./budget.json",
      "assertions": {
        "interaction-to-next-paint": ["error", { "maxNumericValue": 400 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
