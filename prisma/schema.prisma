generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Subscriber {
  id                String    @id @default(cuid())
  email             String    @unique
  subscribedAt      DateTime  @default(now())
  active            Boolean   @default(true)
  unsubscribeToken  String    @unique @default(cuid())
  updatedAt         DateTime  @updatedAt
  emailFrequency    String    @default("all")
  unsubscribeReason String?
  unsubscribedAt    DateTime?
}

model NewsletterDraft {
  id             String       @id @default(cuid())
  title          String
  slug           String       @unique
  summary        String
  content        String
  publishDate    DateTime
  status         String       @default("pending_review")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  type           String       @default("daily")
  sources        Json         @default("[]")
  structuredData Json?
  socialPosts    SocialPost[]
}

model SocialAccount {
  id           String       @id @default(cuid())
  platform     String
  accountName  String
  accessToken  String
  refreshToken String?
  tokenExpiry  DateTime?
  platformId   String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  posts        SocialPost[]
}

model SocialPost {
  id              String          @id @default(cuid())
  newsletterId    String
  platform        String
  content         String
  threadContent   String?
  hashtags        String          @default("[]")
  status          String          @default("draft")
  platformPostId  String?
  platformPostUrl String?
  errorMessage    String?
  postedAt        DateTime?
  accountId       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  account         SocialAccount?  @relation(fields: [accountId], references: [id])
  newsletter      NewsletterDraft @relation(fields: [newsletterId], references: [id], onDelete: Cascade)
}
