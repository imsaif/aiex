// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Subscriber {
  id                String   @id @default(cuid())
  email             String   @unique
  subscribedAt      DateTime @default(now())
  active            Boolean  @default(true)
  unsubscribeToken  String   @unique @default(cuid())
  updatedAt         DateTime @updatedAt
}

model NewsletterDraft {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  summary        String
  content        String   @db.Text
  publishDate    DateTime
  status         String   @default("pending_review") // pending_review, approved, published, rejected
  type           String   @default("daily") // daily, weekly
  sources        Json     @default("[]") // Array of source URLs used
  structuredData Json?    // Structured newsletter data (items, takeaway, etc.) for weekly compilation
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
