// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Subscriber {
  id                String   @id @default(cuid())
  email             String   @unique
  subscribedAt      DateTime @default(now())
  active            Boolean  @default(true)
  unsubscribeToken  String   @unique @default(cuid())
  updatedAt         DateTime @updatedAt
}

model NewsletterDraft {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  summary        String
  content        String
  publishDate    DateTime
  status         String   @default("pending_review") // pending_review, approved, published, rejected
  type           String   @default("daily") // daily, weekly
  sources        Json     @default("[]") // JSON array of source URLs used
  structuredData Json?    // JSON structured newsletter data
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  socialPosts    SocialPost[]
}

model SocialAccount {
  id           String    @id @default(cuid())
  platform     String    // 'twitter' | 'linkedin'
  accountName  String    // e.g., "@yourhandle"
  accessToken  String    // Encrypted
  refreshToken String?   // Encrypted
  tokenExpiry  DateTime?
  platformId   String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  posts        SocialPost[]
}

model SocialPost {
  id              String         @id @default(cuid())
  newsletterId    String
  newsletter      NewsletterDraft @relation(fields: [newsletterId], references: [id], onDelete: Cascade)
  platform        String         // 'twitter' | 'linkedin'
  content         String
  threadContent   String?        // JSON for Twitter threads
  hashtags        String         @default("[]") // JSON array of hashtags
  status          String         @default("draft") // draft | posted | failed
  platformPostId  String?
  platformPostUrl String?
  errorMessage    String?
  postedAt        DateTime?
  accountId       String?
  account         SocialAccount? @relation(fields: [accountId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}
