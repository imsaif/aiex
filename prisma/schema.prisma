generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Subscriber {
  id                String    @id @default(cuid())
  email             String    @unique
  subscribedAt      DateTime  @default(now())
  active            Boolean   @default(true)
  unsubscribeToken  String    @unique @default(cuid())
  updatedAt         DateTime  @updatedAt
  emailFrequency    String    @default("all")
  unsubscribeReason String?
  unsubscribedAt    DateTime?

  // Signup surface (a NEWSLETTER_SOURCES value). Nullable because rows created
  // before 2026-08-01 predate this column — Beehiiv's `signup_source` custom
  // field is the only record for those, and only from mid-April 2026 onward.
  // Kept locally so churn-by-source (source x unsubscribedAt x unsubscribeReason)
  // is queryable without Beehiiv, and so it survives the Beehiiv migration.
  source            String?

  @@index([source])
}

model NewsletterDraft {
  id             String              @id @default(cuid())
  title          String
  slug           String              @unique
  summary        String
  content        String
  publishDate    DateTime
  status         String              @default("pending_review")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  type           String              @default("daily")
  sources        Json                @default("[]")
  structuredData Json?

  // Derived at write time from title + summary + structuredData.items, via
  // src/lib/newsletter/products.ts. Stored rather than computed on render
  // because /news deliberately excludes `structuredData` from its query for load
  // time, and title+summary alone matched nothing on 43% of recent issues.
  // Denormalised, so it drifts if PRODUCT_KEYWORDS changes — re-run
  // scripts/newsletter/backfill-issue-metadata.mjs after editing that map.
  products       String[]            @default([])

  // Reading time in whole minutes, so the /news list no longer has to fetch
  // `content` (~18KB/row, ~1MB across the 60 listed issues) purely to count
  // words. 0 means empty content, which is also how the list detects a
  // quiet-day entry.
  readMinutes    Int?

  socialPosts    SocialPost[]
  patternMatches NewsPatternMatch[]
}

model NewsPatternMatch {
  id           String          @id @default(cuid())
  newsletterId String
  patternSlug  String
  confidence   Float
  rationale    String
  status       String          @default("pending")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  newsletter   NewsletterDraft @relation(fields: [newsletterId], references: [id], onDelete: Cascade)

  @@unique([newsletterId, patternSlug])
  @@index([status])
  @@index([patternSlug, status])
}

model PatternExampleCandidate {
  id            String   @id @default(cuid())
  patternSlug   String
  sourceType    String
  sourceUrl     String
  sourceTitle   String?
  imageUrl      String?
  title         String
  description   String
  rationale     String
  newsletterId  String?
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([patternSlug, status])
}

model PatternCandidate {
  id                String   @id @default(cuid())
  proposedSlug      String
  proposedTitle     String
  proposedCategory  String
  problem           String
  solution          String
  rationale         String
  supportingSources Json     @default("[]")
  clusterSize       Int      @default(0)
  status            String   @default("pending")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
}

model SocialAccount {
  id           String       @id @default(cuid())
  platform     String
  accountName  String
  accessToken  String
  refreshToken String?
  tokenExpiry  DateTime?
  platformId   String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  posts        SocialPost[]
}

model AuditSample {
  id                     String   @id @default(cuid())
  createdAt              DateTime @default(now())
  outcome                String
  isContextFirst         Boolean  @default(false)
  productType            String?
  deviceType             String?
  imageCount             Int      @default(1)
  score                  Int?
  maxScore               Int?
  applicablePatternCount Int      @default(0)
  gapCount               Int      @default(0)
  criticalMissingCount   Int      @default(0)
  errorReason            String?
  errorDetail            String?
  surfaceDescription     String?
  latencyMs              Int?
  ipHash                 String?
  userAgent              String?
  role                   String?
  sessionId              String? // results.id — join key to UiEvent.sessionId (post-result actions)

  @@index([createdAt])
  @@index([outcome])
  @@index([productType])
  @@index([role])
  @@index([sessionId])
}

model PatternIntent {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  intent            String
  source            String   @default("audit_empty_state")
  productType       String?
  suggestedPatterns String   @default("[]")
  latencyMs         Int?
  ipHash            String?
  userAgent         String?

  @@index([createdAt])
  @@index([source])
}

model SocialPost {
  id              String          @id @default(cuid())
  newsletterId    String
  platform        String
  content         String
  threadContent   String?
  hashtags        String          @default("[]")
  status          String          @default("draft")
  platformPostId  String?
  platformPostUrl String?
  errorMessage    String?
  postedAt        DateTime?
  accountId       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  account         SocialAccount?  @relation(fields: [accountId], references: [id])
  newsletter      NewsletterDraft @relation(fields: [newsletterId], references: [id], onDelete: Cascade)
}

// Inbound leads for the paid done-for-you product-audit service (the /services
// page + post-audit CTAs). Quote-based: a lead lands here + emails the admin via
// Resend, the human replies with scope + a Dodo Static Payment Link. No payment
// state is stored here — these rows are the demand + pricing-validation signal.
model ServiceLead {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  name        String
  email       String
  company     String?
  productUrl  String?
  productType String?
  message     String
  budget      String?
  timeline    String?
  source      String   @default("services-page") // services-page | post-audit-cta
  status      String   @default("new") // new | contacted | quoted | won | lost
  ipHash      String?
  userAgent   String?

  @@index([createdAt])
  @@index([status])
}

// Real-user (field) Core Web Vitals, self-reported by the browser via
// /api/vitals. The daily /api/cron/check-web-vitals job computes rolling p75
// per metric and alerts on regressions — the field-data layer LHCI (lab) is
// blind to. Self-testing (aiux:role) is filtered client-side before reporting.
model WebVitalMetric {
  id           String   @id @default(cuid())
  metric       String // LCP | INP | CLS | FCP | TTFB
  value        Float //  ms for LCP/INP/FCP/TTFB; unitless for CLS
  rating       String //  good | needs-improvement | poor (from web-vitals)
  path         String //  pathname, e.g. /patterns/conversational-ui
  device       String //  mobile | desktop (viewport proxy)
  navigationId String? // web-vitals per-metric-instance id (NOT a page-load group key)
  createdAt    DateTime @default(now())

  @@index([metric, createdAt])
  @@index([path, metric, createdAt])
}

// Server-side UI event log. Client mirror of the Clarity custom events fired by
// trackAuditEvent() (src/lib/audit/analytics.ts), beaconed to /api/events so the
// audit funnel + CTA usage is queryable in Postgres — not just in Clarity (which
// is client-side, sampled, prod-only). `name` is allowlisted server-side to the
// known event set. `properties` holds the small tag bag (gapCount, source, etc.).
model UiEvent {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  name       String //  allowlisted event name, e.g. audit_handoff_copied
  sessionId  String? //  audit session id when present (results.id)
  properties Json? //   filterable dimensions passed with the event
  path       String? //  pathname the event fired on
  role       String? //  admin | test excluded from real-user analysis
  ipHash     String? //  salted SHA-256, 16 chars (mirrors AuditSample)
  userAgent  String?

  @@index([name, createdAt])
  @@index([createdAt])
}
