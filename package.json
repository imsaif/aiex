    "jspdf": "^3.0.3",
    "next": "^15.5.7",
    "prisma": "^6.17.1",
    "puppeteer": "^24.30.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.3.8",
    "react-pdf": "^10.2.0",
    "react-syntax-highlighter": "^16.1.0",
    "resend": "^6.1.3",
    "rss-parser": "^3.13.0",
