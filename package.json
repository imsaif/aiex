    "orchestrate:health": "node scripts/agent-orchestrator.js health",
    "orchestrate:workflow": "node scripts/agent-orchestrator.js workflow",
    "context": "node scripts/context-manager.js",
    "context:prime": "node scripts/context-manager.js prime",
    "context:status": "node scripts/context-manager.js status",
    "workflow": "node scripts/workflow-automation.js",
    "workflow:run": "node scripts/workflow-automation.js run",
    "workflow:list": "node scripts/workflow-automation.js list",
    "send-newsletter": "node scripts/send-newsletter.js",
    "validate": "node scripts/agents/validation-agent/validate.mjs",
    "usage": "ccusage",
    "usage:daily": "ccusage daily",
    "usage:weekly": "ccusage weekly",
    "usage:monthly": "ccusage monthly",
    "usage:session": "ccusage session",
    "usage:blocks": "ccusage blocks",
    "usage:json": "ccusage daily --json",
    "error-status": "echo '=== TypeScript Errors ===' && (npx tsc --noEmit | grep -c 'error TS' || echo '0') && echo '=== ESLint Errors ===' && (npm run lint | grep -c 'Error:' || echo '0') && echo '=== Test Status ===' && npm test -- --passWithNoTests --silent",
    "brand:check": "node scripts/brand-validator.js --staged --verbose",
    "brand:check:all": "node scripts/brand-validator.js --verbose",
    "brand:fix": "node scripts/brand-validator.js --staged --fix",
    "fix-all": "npm run ts-fix && npm run lint -- --fix && npm test -- --passWithNoTests && npm run brand:fix"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
