{
  "name": "aiexd",
  "version": "0.1.0",
  "license": "MIT",
  "private": false,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:local": "next build && npm run build:analyze",
    "build:analyze": "node scripts/analysis/build-optimization.js",
    "build:production": "NODE_ENV=production next build",
    "start": "next start",
    "lint": "next lint",
    "lint:hooks": "eslint --config eslint.hooks.config.mjs \"src/**/*.{ts,tsx}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:patterns": "jest src/data/__tests__/patterns.test.ts",
    "test:components": "jest src/components",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium",
    "eval:audit": "TS_NODE_PROJECT=tsconfig.eval.json ts-node -r tsconfig-paths/register tests/audit-evals/run.ts",
    "eval:corpus-check": "TS_NODE_PROJECT=tsconfig.eval.json ts-node -r tsconfig-paths/register tests/audit-evals/validate-corpus.ts",
    "optimize-images": "node scripts/assets/optimize-images.js",
    "convert-gifs": "node scripts/assets/convert-gifs-enhanced.js",
    "perf-audit": "node scripts/analysis/perf-audit.js",
    "perf-audit:local": "node scripts/analysis/perf-audit.js --local",
    "perf-audit:compare": "node scripts/analysis/perf-audit.js --compare",
    "perf-audit:history": "node scripts/analysis/perf-audit.js --history",
    "prepare": "husky",
    "postinstall": "prisma generate",
    "fix-patterns": "ts-node src/data/patterns/utils/fix-patterns.ts",
    "generate-pattern": "node scripts/generators/ai-pattern-generator.js generate",
    "generate-all-patterns": "node scripts/generators/ai-pattern-generator.js generate-all",
    "list-patterns": "node scripts/generators/ai-pattern-generator.js list",
    "generate-guide": "node scripts/generators/ai-guide-generator.js",
    "generate-lesson": "node scripts/generators/ai-guide-generator.js lesson",
    "list-guides": "node scripts/generators/ai-guide-generator.js list",
    "validate-guides": "node scripts/generators/ai-guide-generator.js validate",
    "validate-patterns": "node scripts/generators/validate-patterns.js",
    "design-audit": "node .scripts/design-audit.js",
    "orchestrate": "node scripts/agents/agent-orchestrator.js",
    "orchestrate:health": "node scripts/agents/agent-orchestrator.js health",
    "orchestrate:workflow": "node scripts/agents/agent-orchestrator.js workflow",
    "context": "node scripts/agents/context-manager.js",
    "context:prime": "node scripts/agents/context-manager.js prime",
    "context:status": "node scripts/agents/context-manager.js status",
    "workflow": "node scripts/agents/workflow-automation.js",
    "workflow:run": "node scripts/agents/workflow-automation.js run",
    "workflow:list": "node scripts/agents/workflow-automation.js list",
    "send-newsletter": "node scripts/newsletter/send-newsletter.js",
    "pattern-intel": "node scripts/run-pattern-intel.mjs",
    "validate": "node scripts/agents/validation-agent/validate.mjs",
    "usage": "ccusage",
    "usage:daily": "ccusage daily",
    "usage:weekly": "ccusage weekly",
    "usage:monthly": "ccusage monthly",
    "usage:session": "ccusage session",
    "usage:blocks": "ccusage blocks",
    "usage:json": "ccusage daily --json",
    "error-status": "echo '=== TypeScript Errors ===' && (npx tsc --noEmit | grep -c 'error TS' || echo '0') && echo '=== ESLint Errors ===' && (npm run lint | grep -c 'Error:' || echo '0') && echo '=== Test Status ===' && npm test -- --passWithNoTests --silent",
    "brand:check": "node scripts/analysis/brand-validator.js --staged --verbose",
    "brand:check:all": "node scripts/analysis/brand-validator.js --all --verbose",
    "brand:fix": "node scripts/analysis/brand-validator.js --staged --fix",
    "design-audit:report": "node scripts/analysis/brand-validator.js --all --report",
    "fix-all": "npm run lint -- --fix && npm test -- --passWithNoTests && npm run brand:fix"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "@heroicons/react": "^2.2.0",
    "@lobehub/icons": "^2.43.1",
    "@prisma/client": "^6.17.1",
    "@react-email/components": "^0.5.6",
    "@react-email/render": "^1.3.2",
    "@tailwindcss/typography": "^0.5.16",
    "@types/dompurify": "^3.0.5",
    "@types/puppeteer": "^5.4.7",
    "@vercel/analytics": "^1.5.0",
    "@vercel/og": "^0.8.6",
    "@vercel/speed-insights": "^1.2.0",
    "antd": "^6.0.0",
    "ccusage": "^15.9.4",
    "dompurify": "^3.3.0",
    "dotenv": "^17.2.3",
    "fflate": "^0.8.2",
    "framer-motion": "^12.7.3",
    "fuse.js": "^7.1.0",
    "geist": "^1.5.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.3",
    "next": "^15.5.7",
    "prisma": "^6.17.1",
    "puppeteer": "^24.30.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.3.8",
    "react-pdf": "^10.2.0",
    "react-syntax-highlighter": "^16.1.0",
    "resend": "^6.1.3",
    "rss-parser": "^3.13.0",
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^16.1.6",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.26.0",
    "eslint-config-next": "15.3.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.0.0-beta.3",
    "lighthouse": "^13.0.3",
    "lint-staged": "^16.0.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "zod": "^3.25.42"
  }
}
